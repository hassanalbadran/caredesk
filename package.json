{
  "name": "caredesk",
  "productName": "CareDesk",
  "version": "0.1.0-beta.2",
  "description": "CareDesk — clinic bookings & reminders",
  "author": "Elaph Adnan",
  "license": "MIT",
  "private": false,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "node scripts/make-integrity.js && electron-builder --win --x64 --publish never",
    "test:ui": "node tests/ui/smoke.js && node tests/ui/flows.js && node tests/ui/floor.js && node tests/ui/load.js && node tests/ui/diag.js && node tests/ui/ctx.js && node tests/ui/phone.js",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.2.0"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "^26.0.0",
    "lucide-static": "^0.468.0",
    "playwright": "^1.49.0"
  },
  "build": {
    "appId": "pages.dev.hasn2mr.caredesk",
    "productName": "CareDesk",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json",
      "node_modules/@fontsource/cairo/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1025"
    }
  }
}